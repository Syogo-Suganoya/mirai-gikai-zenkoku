{
  "name": "@mirai-gikai/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./orm": {
      "types": "./src/orm.ts",
      "default": "./src/orm.ts"
    }
  },
  "dependencies": {
    "drizzle-orm": "^0.44.7",
    "postgres": "^3.4.7",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.6.2"
  }
}
