{
  "name": "@mirai-gikai/root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mirai-gikai/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @mirai-gikai/db migrate",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && pnpm db:migrate && pnpm seed",
    "dev": "dotenv -e .env -- pnpm -r --stream --parallel run dev",
    "seed": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed",
    "seed:dummy": "dotenv -e .env -- pnpm --filter @mirai-gikai/seed seed:dummy",
    "admin:create": "dotenv -e .env -- pnpm --filter admin admin:create",
    "test": "pnpm -r --parallel run test",
    "test:coverage": "pnpm -r --parallel run test:coverage",
    "test:integration": "dotenv -e .env -- vitest run --config tests/db/vitest.config.mts && pnpm -r run test:integration",
    "test:integration:watch": "dotenv -e .env -- vitest --config tests/db/vitest.config.mts",
    "build": "dotenv -e .env -- pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome format . && biome lint .",
    "lint:fix": "biome format --write . && biome lint --write .",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "dotenv-cli": "^7.4.2",
    "lint-staged": "^15.5.2",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^3.2.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "pnpm run lint:fix"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
