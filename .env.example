#--- Common ---
# DB の接続先。ローカルは `pnpm db:up` で起動する Docker の PostgreSQL、本番・プレビューは Neon（-pooler の URL）
DATABASE_URL=postgres://postgres:postgres@localhost:54322/mirai_gikai
# Web側のキャッシュを無効化するためのシークレットキー
REVALIDATE_SECRET=your-secret-key-here
# Gemini API のキー（AI はすべて Gemini を直接呼ぶ）
GOOGLE_GENERATIVE_AI_API_KEY=
# AdminサーバーのURL（web/admin両方で使用）
ADMIN_URL=http://localhost:3001

#--- Web ---
# 住民の匿名 ID の Cookie に署名する鍵（本番では必須。32文字以上のランダムな文字列）
VISITOR_COOKIE_SECRET=
# Basic認証をONにする場合は設定してください
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Langfuse設定（プロンプト管理・LLM監視。任意）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Langfuse から読むプロンプトのラベル（任意。既定は production）
LANGFUSE_PROMPT_LABEL=
# Google アナリティクスの測定 ID（任意）
NEXT_PUBLIC_GA_TRACKING_ID=
# AI Chatの日次コストリミット（USD）- ユーザー単位
CHAT_DAILY_USER_COST_LIMIT_USD=
# AI Chatの日次コストリミット（USD）- システム全体
CHAT_DAILY_TOTAL_COST_LIMIT_USD=
# AI Chatの月間コストリミット（USD）- システム全体
CHAT_MONTHLY_TOTAL_COST_LIMIT_USD=

# --- Admin ---
# WebサーバーのURLを設定してください
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# --- ファイル置き場（Vercel Blob。admin だけで使う） ---
# Vercel でストアを admin のプロジェクトにつなぐと自動で入る。ローカルで Blob を試すときだけ、ストアの画面の値を入れる
# 未設定のときは、ローカル開発に限り web/public/local-storage/ に保存する（本番では必須）
BLOB_READ_WRITE_TOKEN=

# --- ローカル開発（pnpm seed） ---
# ローカルの管理者（未設定なら admin@example.com / local-admin-password）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
