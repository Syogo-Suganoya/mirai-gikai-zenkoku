#--- Common ---
# DB の接続先。ローカルは `pnpm db:up` で起動する Docker の PostgreSQL、本番・プレビューは Neon（-pooler の URL）
DATABASE_URL=postgres://postgres:postgres@localhost:54322/mirai_gikai
# Web側のキャッシュを無効化するためのシークレットキー
REVALIDATE_SECRET=your-secret-key-here
# Gemini API のキー（AI はすべて Gemini を直接呼ぶ）
GOOGLE_GENERATIVE_AI_API_KEY=
# AdminサーバーのURL（web/admin両方で使用）
ADMIN_URL=http://localhost:3001

#--- Web ---
# 住民の匿名 ID の Cookie に署名する鍵（本番では必須。32文字以上のランダムな文字列）
VISITOR_COOKIE_SECRET=
# Basic認証をONにする場合は設定してください
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Langfuse設定（プロンプト管理・LLM監視。任意）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# AI Chatの日次コストリミット（USD）- ユーザー単位
CHAT_DAILY_USER_COST_LIMIT_USD=
# AI Chatの日次コストリミット（USD）- システム全体
CHAT_DAILY_TOTAL_COST_LIMIT_USD=
# AI Chatの月間コストリミット（USD）- システム全体
CHAT_MONTHLY_TOTAL_COST_LIMIT_USD=

# --- Admin ---
# WebサーバーのURLを設定してください
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# MCPサーバー（/api/mcp）へのBearer認証トークン
ADMIN_MCP_TOKEN=

# --- ファイル置き場（Cloudflare R2） ---
# 未設定のときは、ローカルの .storage/ ディレクトリに保存する（開発用）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 公開ファイル（サムネイルなど）を配信する URL（R2 のカスタムドメインか r2.dev の URL）
R2_PUBLIC_URL=

# --- ローカル開発（pnpm seed） ---
# ローカルの全体管理者（未設定なら admin@example.com / local-admin-password）
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
